    "!pip -q install ase ipywidgets\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import urllib.request\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from ase.io import read\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display\n",
    "\n",
    "BASE = 'https://raw.githubusercontent.com/jollactic/LiCo2S4/main/PLOTTING'\n",
    "FILES = {\n",
    "    '100': 'sulfur_thermodynamics_100.extxyz',\n",
    "    '311': 'sulfur_thermodynamics_311.extxyz',\n",
    "}\n",
    "\n",
    "for filename in FILES.values():\n",
    "    if not Path(filename).exists():\n",
    "        urllib.request.urlretrieve(f'{BASE}/{filename}', filename)\n",
    "\n",
    "print('Datasets ready.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_dataset(surface):\n",
    "    frames = read(FILES[surface], index=':')\n",
    "    refs = {a.info.get('state'): a for a in frames}\n",
    "\n",
    "    rh = refs.get('S_rhombic')\n",
    "    if rh is None:\n",
    "        raise RuntimeError('Dataset has no S_rhombic reference frame.')\n",
    "\n",
    "    E_rh = float(rh.info['energy_eV'])\n",
    "    n_rh = int(rh.info.get('n_S', sum(x.symbol == 'S' for x in rh)))\n",
    "    mu_rh = E_rh / n_rh\n",
    "\n",
    "    states = [a for a in frames if 'n_added_S' in a.info]\n",
    "    clean = [a for a in states if int(a.info['n_added_S']) == 0]\n",
    "    if len(clean) != 1:\n",
    "        raise RuntimeError(f'Expected one clean/reference slab, found {len(clean)}.')\n",
    "    E0 = float(clean[0].info['energy_eV'])\n",
    "\n",
    "    out = []\n",
    "    for a in states:\n",
    "        N = int(a.info['n_added_S'])\n",
    "        E = float(a.info['energy_eV'])\n",
    "        dE = E - E0 - N * mu_rh\n",
    "        out.append({\n",
    "            'label': str(a.info['state']),\n",
    "            'N': N,\n",
    "            'E': E,\n",
    "            'dE': dE,\n",
    "            'atoms': a,\n",
    "        })\n",
    "    return out, mu_rh\n",
    "\n",
    "\n",
    "def electrochemical_alignment(T=298.15, pH=14.0, a_HS=1.0, E0=-0.065):\n",
    "    kB_eV = 8.617333262e-5\n",
    "    nernst = kB_eV * T * np.log(10.0)\n",
    "    Eeq_SHE = E0 - 0.5 * nernst * pH - 0.5 * nernst * np.log10(a_HS)\n",
    "    Eeq_RHE = Eeq_SHE + nernst * pH\n",
    "    return Eeq_SHE, Eeq_RHE\n",
    "\n",
    "\n",
    "def pretty_label(label):\n",
    "    mapping = {\n",
    "        '*': r'$*$',\n",
    "        'S_4^*': r'$S_4^*$', 'S4^*': r'$S_4^*$', 'S4*': r'$S_4^*$',\n",
    "        'S_6^*': r'$S_6^*$', 'S6^*': r'$S_6^*$', 'S6*': r'$S_6^*$',\n",
    "        'S_8^*': r'$S_8^*$', 'S8^*': r'$S_8^*$', 'S8*': r'$S_8^*$',\n",
    "        'S_8@*': r'$S_8@*$', 'S8@*': r'$S_8@*$',\n",
    "    }\n",
    "    return mapping.get(label, label)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "surface_w = widgets.Dropdown(options=['100', '311'], value='100', description='Surface:')\n",
    "U_w = widgets.FloatSlider(value=0.30, min=-0.5, max=0.8, step=0.01, description='U / V RHE:', continuous_update=False)\n",
    "pH_w = widgets.FloatSlider(value=14.0, min=0.0, max=14.0, step=0.5, description='pH:', continuous_update=False)\n",
    "a_w = widgets.FloatLogSlider(value=1.0, base=10, min=-4, max=0, step=0.25, description='a(HS\u207b):', continuous_update=False)\n",
    "T_w = widgets.FloatText(value=298.15, description='T / K:')\n",
    "\n",
    "display(widgets.VBox([surface_w, U_w, pH_w, a_w, T_w]))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_results(surface='100', U=0.30, pH=14.0, a_HS=1.0, T=298.15):\n",
    "    states, mu_rh = load_dataset(surface)\n",
    "    Eeq_SHE, Eeq_RHE = electrochemical_alignment(T=T, pH=pH, a_HS=a_HS)\n",
    "    dmu_at_U = 2.0 * (U - Eeq_RHE)\n",
    "\n",
    "    # ---- Phase diagram ----\n",
    "    dmu = np.linspace(-1.2, 0.35, 700)\n",
    "    omega = np.vstack([s['dE'] - s['N'] * dmu for s in states])\n",
    "    envelope = omega.min(axis=0)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8.5, 5.8))\n",
    "    for s, y in zip(states, omega):\n",
    "        ax.plot(dmu, y, lw=1.8, label=pretty_label(s['label']))\n",
    "    ax.plot(dmu, envelope, 'k--', lw=3, label='lowest state')\n",
    "    ax.axvline(0, ls=':', lw=1.3)\n",
    "    ax.axvline(dmu_at_U, ls='--', lw=1.5)\n",
    "    ax.axhline(0, ls='--', lw=0.8)\n",
    "    ax.set_xlabel(r'$\\Delta\\mu_{\\rm S}=\\mu_{\\rm S}-\\mu_{\\rm S}^{\\rm rhombic}$ / eV')\n",
    "    ax.set_ylabel(r'$\\Delta\\Omega$ / eV')\n",
    "    ax.set_title(rf'NiCo$_2$S$_4$({surface}) sulfur stability')\n",
    "    ax.legend()\n",
    "\n",
    "    def dmu_to_rhe(x): return Eeq_RHE + x / 2.0\n",
    "    def rhe_to_dmu(x): return 2.0 * (x - Eeq_RHE)\n",
    "    sec = ax.secondary_xaxis('top', functions=(dmu_to_rhe, rhe_to_dmu))\n",
    "    sec.set_xlabel(rf'$U$ / V vs RHE   (pH={pH:g}, $a_{{HS^-}}$={a_HS:g})')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # ---- Energy levels at chosen voltage ----\n",
    "    values = np.array([s['dE'] - s['N'] * dmu_at_U for s in states])\n",
    "    imin = int(np.argmin(values))\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8.0, 5.2))\n",
    "    half = 0.30\n",
    "    for i, (s, y) in enumerate(zip(states, values)):\n",
    "        ax.hlines(y, i-half, i+half, lw=2.5)\n",
    "        ax.text(i, y + 0.06, f'{y:.2f}', ha='center', va='bottom', fontsize=9)\n",
    "    ax.set_xticks(range(len(states)))\n",
    "    ax.set_xticklabels([pretty_label(s['label']) for s in states])\n",
    "    ax.axhline(0, ls='--', lw=0.8)\n",
    "    ax.set_ylabel(r'$\\Delta\\Omega(U)$ / eV')\n",
    "    ax.set_xlabel('Surface sulfur state')\n",
    "    ax.set_title(rf'NiCo$_2$S$_4$({surface}) at $U={U:.2f}$ V vs RHE')\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    print(f'mu_S(rhombic) = {mu_rh:.8f} eV/S')\n",
    "    print(f'E_eq = {Eeq_RHE:.4f} V vs RHE  ({Eeq_SHE:.4f} V vs SHE)')\n",
    "    print(f'Chosen U = {U:.4f} V vs RHE')\n",
    "    print(f'Delta mu_S(U) = {dmu_at_U:.4f} eV')\n",
    "    print(f'Lowest state at chosen U: {states[imin][\"label\"]}  ({values[imin]:.4f} eV)')\n",
    "\n",
    "    print('\\nState energies at chosen potential')\n",
    "    print('-' * 60)\n",
    "    for s, y in zip(states, values):\n",
    "        print(f'{s[\"label\"]:12s}  N_S={s[\"N\"]:2d}  DeltaOmega={y:10.4f} eV')\n",
    "\n",
    "\n",
    "out = widgets.interactive_output(\n",
    "    plot_results,\n",
    "    {'surface': surface_w, 'U': U_w, 'pH': pH_w, 'a_HS': a_w, 'T': T_w}\n",
    ")\n",
    "display(out)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Interpretation\n",
    "\n",
    "For each state $i$,\n",
    "\n",
    "$$\\Delta\\Omega_i(U)=\\Delta E_i^{\\rm rhombic}-N_{S,i}\\Delta\\mu_S(U),$$\n",
    "\n",
    "where\n",
    "\n",
    "$$\\Delta\\mu_S(U)=2(U_{\\rm RHE}-E_{\\rm eq,RHE}).$$\n",
    "\n",
    "The vertical dashed line in the phase diagram marks the selected voltage. The energy-level plot evaluates every candidate state at exactly that voltage. The lowest level is the thermodynamically preferred state among the structures included in the dataset."
   ]
  }
 ],
